LANGFUSE_SALT=replace-with-random-salt
LANGFUSE_ENCRYPTION_KEY=replace-with-64-character-lowercase-hex
LANGFUSE_NEXTAUTH_SECRET=replace-with-long-random-secret
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse-change-me
LANGFUSE_DB_NAME=langfuse
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=langfuse-clickhouse-change-me
LANGFUSE_MINIO_USER=minio
LANGFUSE_MINIO_PASSWORD=langfuse-minio-change-me
LANGFUSE_TELEMETRY_ENABLED=false
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
PROMETHEUS_PORT=9092
PROMETHEUS_RETENTION=15d
GRAFANA_IMAGE=grafana/grafana:12.1.0
GRAFANA_PORT=3001
