# PostgreSQL 业务库。宿主机开发默认连接基础设施容器的 5433 端口。
IFACEOFF_DATABASE_URL=postgresql://ifaceoff_app:ifaceoff-app-change-me@127.0.0.1:5433/ifaceoff_app
AGENT_DATABASE_URL=postgresql://ifaceoff_agent:ifaceoff-agent-change-me@127.0.0.1:5433/ifaceoff_agent
AGENT_SERVICE_TOKEN=replace-with-a-long-random-internal-token
LITELLM_DATABASE_URL=postgresql://litellm:litellm-change-me@127.0.0.1:5433/litellm
LANGFUSE_DATABASE_URL=postgresql://langfuse:langfuse-change-me@127.0.0.1:5433/langfuse
POSTGRES_POOL_ENABLED=false
POSTGRES_DISABLE_SERVER_SIDE_CURSORS=true

# Django 配置
SECRET_KEY=<your_strong_django_secret_key> # 强烈建议生成一个新的
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 # 开发环境，生产环境请改为你的前端域名

# Redis & RabbitMQ (使用 Docker 内部主机名)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_REALTIME_URL=redis://redis:6379/3
INTERVIEW_LOCK_TIMEOUT_MS=1500
AGENT_EXECUTION_STALE_SECONDS=360
RABBITMQ_HOST=rabbitmq

# 邮件发送配置 (用于注册验证码)
EMAIL_HOST=<your_smtp_server> # 例如: smtp.qq.com
EMAIL_HOST_USER=<your_email_address>
EMAIL_HOST_PASSWORD=<your_email_auth_code> # 通常是16位授权码，不是邮箱密码

# GitHub OAuth 配置
GITHUB_CLIENT_ID=<your_github_client_id>
GITHUB_CLIENT_SECRET=<your_github_client_secret>
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
PUBLIC_FRONTEND_URL=http://127.0.0.1:5173
PUBLIC_ADMIN_URL=http://127.0.0.1:5174
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/auth/oauth/github/callback/


# 默认 AI 服务的 API Key
DEEPSEEK_API_KEY=<your_ai_service_api_key>

# 面试 Agent / RAG 配置
INTERVIEW_AGENT_ENGINE=composite_v4
AGENT_STATE_SCHEMA_VERSION=4
AGENT_MEMORY_EVENT_RETENTION_DAYS=30
AGENT_CHECKPOINT_RETENTION_DAYS=30
AGENT_MAX_GENERATION_RETRIES=2
CELERY_INSPECT_TIMEOUT_SECONDS=2
AGENT_EVALUATION_CONFIDENCE_THRESHOLD=0.6
AGENT_NODE_TIMEOUT_SECONDS=30
INTERVIEW_GENERATION_JOB_STALE_SECONDS=90
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=interview_knowledge
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=<your_embedding_api_key>
EMBEDDING_BASE_URL=
ASR_CHUNK_SECONDS=2
ASR_MIN_CONFIDENCE=0.65
SPEECH_MAX_AUDIO_BYTES=26214400
HYBRID_SEARCH_PARALLELISM=4
TTS_CACHE_SECONDS=86400
SPEECH_PROVIDER_TIMEOUT_SECONDS=30
TTS_DEFAULT_VOICE=alloy
TTS_RESPONSE_FORMAT=mp3
