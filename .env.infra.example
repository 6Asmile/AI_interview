# Ifaceoff local infrastructure only. The Django/Vue applications run on the host.
COMPOSE_PROJECT_NAME=ifaceoff-infra
TZ=Asia/Shanghai

# One PostgreSQL 16 instance, four isolated databases/roles.
POSTGRES_PORT=5433
POSTGRES_SUPERUSER=ifaceoff_admin
POSTGRES_SUPERUSER_PASSWORD=ifaceoff-admin-change-me
IFACEOFF_DB_NAME=ifaceoff_app
IFACEOFF_DB_USER=ifaceoff_app
IFACEOFF_DB_PASSWORD=ifaceoff-app-change-me
AGENT_DB_NAME=ifaceoff_agent
AGENT_DB_USER=ifaceoff_agent
AGENT_DB_PASSWORD=ifaceoff-agent-change-me
LANGFUSE_DB_NAME=langfuse
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse-change-me

REDIS_PORT=6379

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# LiteLLM model gateway. Replace all example secrets outside local development.
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm@sha256:2fdd90b14e3d9244ce297f418b983d8cfd90ba6e72a10a8ddb30f7cf64852390
LITELLM_PORT=4000
LITELLM_MASTER_KEY=ifaceoff-local-master-change-me
LITELLM_SALT_KEY=ifaceoff-local-salt-change-me
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=litellm-change-me

MEILISEARCH_PORT=7700
MEILI_ENV=development
MEILI_MASTER_KEY=ifaceoff-local-search-key

CLAMAV_PORT=3310
