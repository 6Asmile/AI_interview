# Ifaceoff Docker environment template.
# Copy to .env.docker before running Docker Compose:
#   copy .env.docker.example .env.docker

COMPOSE_PROJECT_NAME=ifaceoff

# Ports exposed on the host
FRONTEND_PORT=80
BACKEND_PORT=8000
POSTGRES_PORT=5433
REDIS_PORT_PUBLIC=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
MEILISEARCH_PORT=7700

# PostgreSQL: one physical instance with isolated databases and roles.
POSTGRES_SUPERUSER=ifaceoff_admin
POSTGRES_SUPERUSER_PASSWORD=ifaceoff-admin-change-me
IFACEOFF_DB_NAME=ifaceoff_app
IFACEOFF_DB_USER=ifaceoff_app
IFACEOFF_DB_PASSWORD=ifaceoff-app-change-me
AGENT_DB_NAME=ifaceoff_agent
AGENT_DB_USER=ifaceoff_agent
AGENT_DB_PASSWORD=ifaceoff-agent-change-me
AGENT_SERVICE_TOKEN=replace-with-a-long-random-internal-token
AGENT_SERVICE_PORT=8010
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=litellm-change-me
LANGFUSE_DB_NAME=langfuse
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse-change-me
IFACEOFF_DATABASE_URL=postgresql://ifaceoff_app:ifaceoff-app-change-me@postgres:5432/ifaceoff_app
AGENT_DATABASE_URL=postgresql://ifaceoff_agent:ifaceoff-agent-change-me@postgres:5432/ifaceoff_agent

# Django
SECRET_KEY=change-me-use-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,Ifaceoff-backend
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80

# Redis / RabbitMQ / Qdrant / Meilisearch
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_COORDINATION_URL=redis://redis:6379/2
REDIS_REALTIME_URL=redis://redis:6379/3
REDIS_KEY_HMAC_SECRET=
ADMISSION_TRUSTED_PROXY_IPS=
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
EMAIL_VERIFICATION_CODE_TTL_SECONDS=300
WS_TICKET_TTL_SECONDS=45
REDIS_IMAGE=redis:7.4.5-alpine
REDIS_CACHE_MAXMEMORY=1gb
REDIS_COORDINATION_MAXMEMORY=512mb
REDIS_REALTIME_MAXMEMORY=1gb
INTERVIEW_LOCK_TIMEOUT_MS=1500
AGENT_EXECUTION_STALE_SECONDS=360
AGENT_EXECUTION_LEASE_SECONDS=360
OPERATION_LEASE_SECONDS=300
OPERATION_DISPATCH_BATCH_SIZE=100
ASYNC_OPERATION_V2_DOMAINS=resume,career,knowledge,media,community
AGENT_WORKER_CONCURRENCY=8
DOCUMENT_WORKER_CONCURRENCY=2
CELERY_WORKER_MEMORY_LIMIT=2g
CELERY_WORKER_CPUS=2.0
CELERY_WORKER_PIDS_LIMIT=256
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=ifaceoff_app
RABBITMQ_PASSWORD=replace-with-a-long-secret
RABBITMQ_VHOST=ifaceoff
RABBITMQ_IMAGE=rabbitmq:4.3.4-management-alpine
CELERY_TOPOLOGY_VERSION=v2
RABBITMQ_DELIVERY_LIMIT=12
RABBITMQ_QUORUM_MAX_LENGTH=100000
RABBITMQ_QUORUM_MAX_LENGTH_BYTES=1073741824
RABBITMQ_DLQ_MAX_LENGTH=10000
RABBITMQ_DLQ_MAX_LENGTH_BYTES=268435456
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=interview_knowledge
MEILISEARCH_URL=http://meilisearch:7700
MEILI_MASTER_KEY=ifaceoff-local-search-key
MEILISEARCH_API_KEY=ifaceoff-local-search-key
MEILISEARCH_KNOWLEDGE_INDEX=interview_knowledge_chunks

# Agent / RAG
INTERVIEW_AGENT_ENGINE=composite_v4
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_CONTEXT_TOKEN_BUDGET=6000
AGENT_ENABLE_SLASH_COMMANDS=true
AGENT_ENABLE_MCP_ADAPTER=false
AGENT_PROMPT_VERSION=interview-agent-v1
AGENT_STATE_SCHEMA_VERSION=4
AGENT_MEMORY_EVENT_RETENTION_DAYS=30
AGENT_CHECKPOINT_RETENTION_DAYS=30
AGENT_V3_DEFAULT_TARGET_DURATION_MINUTES=30
AGENT_V3_DEFAULT_MIN_DURATION_MINUTES=20
AGENT_V3_DEFAULT_HARD_MAX_DURATION_MINUTES=45
AGENT_MAX_GENERATION_RETRIES=2
CELERY_INSPECT_TIMEOUT_SECONDS=2
AGENT_EVALUATION_CONFIDENCE_THRESHOLD=0.6
AGENT_NODE_TIMEOUT_SECONDS=30
DOCUMENT_PARSER=docling
DOCLING_ENABLE_OCR=true
DOCLING_ENABLE_TABLE_STRUCTURE=true
OCR_ENGINE=paddleocr
PADDLEOCR_LANG=ch
HYBRID_SEARCH_TOPN=30
HYBRID_SEARCH_TOPK=4
HYBRID_SEARCH_PARALLELISM=4

# Speech
ASR_CHUNK_SECONDS=2
ASR_MIN_CONFIDENCE=0.65
SPEECH_MAX_AUDIO_BYTES=26214400
TTS_CACHE_SECONDS=86400
SPEECH_PROVIDER_TIMEOUT_SECONDS=30
TTS_DEFAULT_VOICE=alloy
TTS_RESPONSE_FORMAT=mp3

# Model gateway defaults.
# Prefer configuring real keys in the web Settings page; these env keys are fallback only.
MODEL_GATEWAY_TIMEOUT_SECONDS=30
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Optional Aliyun Bailian workspace values for reference.
BAILIAN_OPENAI_BASE_URL=
BAILIAN_DASHSCOPE_BASE_URL=
BAILIAN_API_KEY=

# Email / OAuth optional
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
PUBLIC_FRONTEND_URL=http://127.0.0.1:5173
PUBLIC_ADMIN_URL=http://127.0.0.1:5174
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/auth/oauth/github/callback/
